+    @apply text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy leading-[1.1] tracking-tight;
+  }
+  .heading-page {
+    @apply text-4xl sm:text-5xl font-bold text-white mb-4;
+  }
+  .heading-section {
+    @apply text-3xl sm:text-4xl font-bold text-navy leading-tight tracking-tight mb-4;
+  }
+  .heading-section-light {
+    @apply text-3xl sm:text-4xl font-bold text-white leading-tight tracking-tight mb-4;
+  }
+  .heading-card {
+    @apply font-bold text-navy text-lg leading-snug;
+  }
+  .text-body {
+    @apply text-muted-foreground text-base leading-relaxed;
+  }
+  .text-body-sm {
+    @apply text-muted-foreground text-sm leading-relaxed;
+  }
+  
+  /* Layout & Spacing */
+  .section-pad {
+    @apply py-16 sm:py-20 lg:py-24;
+  }
+  .container-width {
+    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
+  }
+  .section-tag {
+    @apply inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-semibold uppercase tracking-widest rounded mb-4;
+  }
+  .section-tag-light {
+    @apply inline-block px-3 py-1 bg-white/10 text-white/90 text-xs font-semibold uppercase tracking-widest rounded mb-4;
+  }
+
+  /* Components */
+  .card-standard {
+    @apply bg-card rounded-xl p-6 sm:p-7 shadow-sm border border-card-border hover:shadow-md transition-all duration-300 hover:border-primary/20 flex flex-col h-full;
+  }
+  .btn-primary {
+    @apply inline-flex items-center gap-2 justify-center px-8 py-3.5 bg-primary text-primary-foreground hover:bg-primary/90 text-sm font-semibold rounded-lg transition-all duration-200;
+  }
+  .btn-outline {
+    @apply inline-flex items-center gap-2 justify-center px-8 py-3.5 bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white text-sm font-semibold rounded-lg transition-all duration-200;
+  }
+  .btn-light {
+    @apply inline-flex items-center gap-2 justify-center px-8 py-3.5 bg-white text-primary hover:bg-blue-50 text-sm font-semibold rounded-lg transition-all duration-200 shadow-sm hover:shadow;
+  }
+}
